# Application
APP_NAME="SemAlign API"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/semalign.db
# DATABASE_URL=postgresql://user:password@localhost:5432/semalign

# Security
# 生成安全的密钥
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Upload
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=20971520  # 20MB
ALLOWED_EXTENSIONS=[".xlsx",".xls",".pdf"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# LLM Gateway (optional)
FOURZ_API_BASE=https://4zapi.com/v1
FOURZ_API_MODEL=gpt-4o-mini
FOURZ_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Search RAG (optional)
# SEARCH_RAG_ENABLED=true
# SEARCH_RAG_TOP_K=5
# RAG_ALGORITHM=naive   # naive | hyde | rqrag | autograph
