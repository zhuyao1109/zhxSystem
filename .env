# 复制为 .env 后修改: cp .env.docker.example .env

# 前端对外端口
FRONTEND_PORT=8080

# 生产环境必须修改（至少 32 位）
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key-32chars

# 若前后端不同域才需要；Docker 默认同域 /api 代理，可保持默认
# 额外放开局域网 IP，便于演示机通过 10.x 地址访问
CORS_ORIGINS=["http://localhost:8080","http://localhost","http://10.1.48.61:8080","http://10.1.48.61"]

# 大模型：优先 FOURZ，其次 DeepSeek（OpenAI 兼容）
FOURZ_API_KEY=
FOURZ_API_BASE=
FOURZ_API_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=sk-5322ea6851fb4fd49c6b7e32b5320caf
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
SEARCH_RAG_ENABLED=false

# 对齐助手：auto=有 Key 用大模型否则向量检索 | vector_engine | llm
ALIGNMENT_CHAT_MODE=auto
